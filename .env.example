# ─────────────────────────────────────────────────────────────────────────────
# Heramb.study — environment configuration
# Copy to .env.local for development. NEVER commit a populated env file.
# NEXT_PUBLIC_* values are embedded in the browser bundle — never put secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public site identity ─────────────────────────────────────────────────────
# Production origin, HTTPS, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://heramb.study
NEXT_PUBLIC_BRAND_NAME=Heramb.study
# The person or legal entity that operates the site (shown on /about and legal pages).
# Leave empty until confirmed — pages will show a clearly marked placeholder.
NEXT_PUBLIC_OPERATOR_NAME=Kartikeya Mishra
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional social profile URLs (leave empty to hide).
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# ── Future native apps (leave empty until real store listings exist) ───────
# Empty => the badges render as accessible, non-navigating "Coming soon" controls.
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=

# ── Firebase web config (RESERVED for the future authenticated app) ─────────
# The launch site does not load the Firebase client SDK. These are not secrets,
# but they are unused until the student/teacher app is built.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (SERVER ONLY — secrets) ──────────────────────────────────
# Option A: service-account fields (Vercel / any Node host).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences; they are converted at runtime.
FIREBASE_PRIVATE_KEY=
# Option B: Application Default Credentials (Firebase App Hosting / Cloud Run).
# Set to true and leave the three fields above empty.
FIREBASE_USE_ADC=false

# Secret used to hash IP addresses for rate limiting (any long random string).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# ── Development only ────────────────────────────────────────────────────────
# true => invite/contact submissions are kept in process memory (lost on restart).
# Ignored when NODE_ENV=production; production without Firebase returns an honest 503.
DEV_MEMORY_STORE=false

# ── Analytics & Search Console (optional) ───────────────────────────────────
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Empty => no analytics script loads at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Value of the google-site-verification meta tag (prefer DNS verification instead).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Advertising (DISABLED BY DEFAULT) ───────────────────────────────────────
# Do not enable until the site is approved by Google AdSense. Never invent IDs.
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Format: ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Numeric ad-unit slot ID for the in-article resource slot.
NEXT_PUBLIC_ADSENSE_SLOT_RESOURCE=
NEXT_PUBLIC_ADSENSE_AUTO_ADS_ENABLED=false

# ── Payments (DISABLED — not implemented in the launch release) ─────────────
RAZORPAY_ENABLED=false
PAYPAL_ENABLED=false

# ── Rate limits (optional overrides; defaults shown) ────────────────────────
# RATE_LIMIT_INVITE_PER_IP=5    # invite requests per IP per 10 minutes
# RATE_LIMIT_CONTACT_PER_IP=3   # contact messages per IP per 10 minutes

# Which X-Forwarded-For hop is the real client: "first" (Vercel, default) or "gcp"
# (Firebase App Hosting / Cloud Run behind Google's load balancer).
CLIENT_IP_MODE=first

# ── Email (OPTIONAL — off until configured) ─────────────────────────────────
# Transactional email via Resend (https://resend.com). Verify your sending domain there first.
RESEND_API_KEY=
# A verified sender, e.g. "Heramb.study <hello@heramb.study>"
EMAIL_FROM=
# Signs confirm/unsubscribe links. ≥ 32 random chars. Changing it invalidates old links.
EMAIL_TOKEN_SECRET=
# Where new pilot applications are announced (your own inbox).
OWNER_NOTIFICATION_EMAIL=
# RATE_LIMIT_PILOT_PER_IP=3     # pilot applications per IP per 10 minutes
# RATE_LIMIT_JOIN_PER_IP=10     # founding sign-ups per network per 10 minutes (meetups on one Wi-Fi)

# ── AI (OPTIONAL — off by default; rule-based summaries work without it) ────
# none | anthropic | openai_compatible
AI_PROVIDER=none
AI_API_KEY=
# Anthropic default is the small, low-cost tier (claude-haiku-5-5). For openai_compatible, required.
AI_MODEL=
# openai_compatible only: https base URL of the chat-completions endpoint, e.g. https://gateway.example.com/v1
AI_BASE_URL=
# Cost guards: AI summaries per visitor per day on the free plan (can only LOWER the plan default of 5),
# and the total AI calls per day across the whole site (default 300). Over the cap, users get rule-based summaries.
AI_FREE_DAILY_LIMIT=
AI_GLOBAL_DAILY_LIMIT=300

# ── Founding institute programme (v0.7) ─────────────────────────────────────
# Number of numbered founding seats (founding discount on any future paid plan). Default 50.
FOUNDING_CAP=50
# Show the public live counter (/api/stats/public, homepage band) only once at least this many
# institutes have joined. Never shows estimates. Default 3.
PUBLIC_STATS_MIN=3
# Owner dashboard at /admin. Off (404) unless this is set to 12+ characters. Use a long random
# passphrase; changing it signs you out everywhere. Server-only — never prefix with NEXT_PUBLIC_.
OWNER_DASHBOARD_PASSWORD=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/digest every Monday
# (vercel.json). 16+ random characters. Without it the weekly digest never runs.
CRON_SECRET=
# Photo/PDF marksheet imports per network per day (uses the AI provider above; also counts
# towards AI_GLOBAL_DAILY_LIMIT). Default 10.
IMPORT_PHOTO_DAILY_LIMIT=10
# Optional founding price lock shown on /founding: "never more than ₹X a month" (whole rupees).
# Leave empty until you have decided the number — the page then promises only a founding discount.
FOUNDING_PRICE_CAP_INR=
# City comparison on institute dashboards appears per chapter only when at least this many
# founding institutes in the same city (including the viewer) shared results. Default 5.
BENCHMARK_MIN_INSTITUTES=5
# Set to true after every [placeholder] in /privacy and /terms is replaced (shown on /admin).
LEGAL_PAGES_REVIEWED=false
