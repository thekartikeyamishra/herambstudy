# ─────────────────────────────────────────────────────────────────────────────
# Developer settings — copy to .env.development.local
#
#   Copy-Item .env.development.example .env.development.local     (PowerShell)
#
# Next.js reads .env.development.local ONLY for `npm run dev`. A production build
# (`npm run build`) never loads it, and the code also ignores every flag below when
# NODE_ENV=production. So nothing here can leak into the live site.
# Then open http://localhost:3000/dev for the developer hub.
# ─────────────────────────────────────────────────────────────────────────────

# Keep invite / pilot / contact submissions in memory (inspect them at /dev).
DEV_MEMORY_STORE=true

# Capture emails at /dev instead of sending them (acknowledgement, pilot alerts).
EMAIL_DEV_OUTBOX=true
OWNER_NOTIFICATION_EMAIL=owner@heramb.test
# Signs confirm / unsubscribe links. Any 32+ character string is fine for development.
EMAIL_TOKEN_SECRET=dev-only-email-token-secret-change-me-0123456789

# Free offline AI for testing the summary path. Modes: ok | fail | garbage | slow
AI_PROVIDER=mock
AI_MOCK_MODE=ok

# Show a dashed placeholder where an ad would appear (no Google script loads).
NEXT_PUBLIC_ADS_PREVIEW=true

# Uncomment to see store badges as real links (any https URL works for testing).
# NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=example.test
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id000000000

# Uncomment to see the analytics consent banner. A fake ID shows the banner; if you
# click "Allow", the browser will try to contact Google — that's expected.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DEVTEST0

# Raise rate limits so repeated manual testing isn't blocked (or clear them at /dev).
RATE_LIMIT_INVITE_PER_IP=100
RATE_LIMIT_CONTACT_PER_IP=100
RATE_LIMIT_PILOT_PER_IP=100
