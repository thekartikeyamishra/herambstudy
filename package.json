{
  "name": "heramb-study",
  "version": "0.7.0",
  "private": true,
  "description": "Heramb.study \u2014 invite-only launch website. Progress, made visible.",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:memory": "cross-env DEV_MEMORY_STORE=true next dev",
    "build": "next build",
    "postbuild": "node scripts/assert-no-devtools.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --only firestore --project demo-heramb \"npx vitest run --config vitest.rules.config.ts\"",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "waitlist": "node scripts/waitlist-admin.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "firebase": "12.12.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
